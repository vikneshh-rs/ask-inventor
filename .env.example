# ==========================================
# ASK INVENTORS — ENVIRONMENT VARIABLES TEMPLATE
# ==========================================
# Copy this file to .env.local for local development.
# NEVER commit .env or .env.local with real secrets.

# ------------------------------------------
# Application Configuration
# ------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ------------------------------------------
# Supabase Configuration
# ------------------------------------------
# Browser / Client accessible (Public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only Privileged Access (NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------
# Resend Email Configuration (Server-side)
# ------------------------------------------
# Resend API Key (NEVER expose to browser)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=noreply@askinventors.in
